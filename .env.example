# The profile name and username the bot sets on its own Signal account at startup.
BOT_NAME=signai
BOT_USERNAME=signai

# API key used for OpenAI requests.
OPENAI_API_KEY=sk-proj-qwerty

# System message put at the head of every new dialog. It is the whole personality of the bot, so it
# is worth more than one line: what it is, how long its answers should be, which language to answer
# in. Signal renders no markdown, which the model has to be told.
CHAT_SYSTEM_PROMPT=You are a member of a Signal group chat. Answer in the language you were addressed in, keep it to a few sentences unless more is asked for, and write plain text — Signal renders no markdown.

# OpenAI model used for chat completions.
GPT_MODEL=gpt-5.6

# How many `chat` requests one user may send per hour. Falls back to 30 if this is not a number.
REQUESTS_PER_USER_PER_HOUR=10

# Where signal-cli-rest-api answers: the service name on the compose network, not a published port
# on the host. The port published for linking the account is not this one.
SIGNAL_API_URL=http://signal-cli-rest-api:8080

# The number of the Signal account linked to signal-cli-rest-api, the one the bot speaks as.
SIGNAL_PHONE_NUMBER=+380980000000

# --- everything below is optional ---

# A profile picture to use instead of the one packaged in the image. Mount it into the container
# first: an unreadable path stops the bot on startup rather than quietly leaving the old picture.
# AVATAR_FILE=/app/avatar.jpg
