# The number of the Signal account linked to signal-cli-rest-api, the one the bot speaks as.
SIGNAL_PHONE_NUMBER=+380980000000

# API key used for OpenAI requests.
OPENAI_API_KEY=sk-proj-qwerty

# OpenAI model used for chat completions.
GPT_MODEL=gpt-5.6

# Optional. System message put at the head of every new dialog. Defaults to the prompt below.
# CHAT_SYSTEM_PROMPT=You are a participant in a Signal chat. Answer in the language you were addressed in, keep it to a few sentences unless more is asked for, and write plain text — Signal renders no markdown.

# Optional. How many `chat` requests one user may send per hour. Defaults to 30 when unset or invalid.
# REQUESTS_PER_USER_PER_HOUR=30

# Optional. Where signal-cli-rest-api answers. Defaults to the service on the Compose network.
# SIGNAL_API_URL=http://signal-cli-rest-api:8080
